# Copy to .env and fill in. Everything here is optional: the foundation runs
# without any of it, which is why there is no .env in a fresh checkout.

# Signs session cookies. Generated per process when unset, so restarting the
# server signs everyone out — fine while the database is rebuilt on every start
# too, but set it once accounts are meant to survive a restart.
SECRET_KEY=

# Marks the session cookie Secure. Leave false for plain-HTTP localhost, where
# a Secure cookie is simply dropped. Set true behind HTTPS.
SESSION_COOKIE_SECURE=false

# Not read by anything yet. The AI chat will use it.
OPENROUTER_API_KEY=
